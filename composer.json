{
    "name": "gsnugroho/laravel-rescue-audit",
    "description": "One-command health & security audit for existing Laravel apps. Generates an HTML/Markdown report with a 0-100 score and estimated fix hours.",
    "keywords": ["laravel", "audit", "security", "owasp", "code-quality", "takeover"],
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Galih S. Nugroho",
            "homepage": "https://gsnugroho.github.io"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "illuminate/console": "^10.0|^11.0|^12.0",
        "illuminate/routing": "^10.0|^11.0|^12.0",
        "illuminate/view": "^10.0|^11.0|^12.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0",
        "phpunit/phpunit": "^10.0|^11.0"
    },
    "autoload": {
        "psr-4": {
            "RescueAudit\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "RescueAudit\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "RescueAudit\\RescueAuditServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
